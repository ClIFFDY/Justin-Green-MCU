// ============================================================
// MCU v1.2 上板程序（MicroPhase Z-7 Lite，PL 引脚）
//   UART 走 GPIO：pin0=RX(N17)  pin1=TX(P18)  pin6=LED(P15,低电平点亮)  pin7=KEY2(T12,按下低电平)
//   Phase0 配置：pin0=RX / pin1=TX / pin6=OUT / pin7=IRQ（KEY2 低电平触发，需 gpio_group 的
//               IRQ 已反转成低电平有效：gpio_irq[0/1] <= ~gpio_pin_bus[i]）
//   Phase1 上电输出 "cpu ready\r\n"（send_char 子程序，LJAL 调用 / JALR 返回）
//   Phase2 KEY2 按下→GPIO2 中断(0xA0)→翻转 r2（uart tx 回环开关）
//   Phase3 timer 中断(0xD0)每 1.31ms：r4 递减 LED 计数，~153 tick ≈ 0.2s 亮/灭
//   Phase4 UART 中断(0xE8)：弹 FIFO，XORI 0x20 翻转大小写，r2=1 时回发
//  布局：配置 0x00-0x3B → 0x3C RBEQ 跳过 send_char(0x40) → banner 0x4E-0x8F → idle 0x90
// 寄存器：r0=0  r1=发字符  r2=回环开关(1开)  r3=UART ISR 收/回显  r4=LED 计数  r5=GPIO2 ISR 暂存  r7=LED灭常量
// 编码（mc_v1.2_ins.md）：ADDI=0x07 SUBI=0x0F XORI=0x33 SB=0x77 LBU=0x73 LBEQ=0x5B RBEQ=0x5F
//   LBNE=0x63 LJAL=0x21(2B) JALR=0x4D(2B) NOP=0x50 IRET=0x54；bytmov=(指令地址+len)-目标(后跳)/目标-(指令地址+len)(前跳)
// ============================================================
@0000
07 01 00 06   // 0x00 ADDI r1,r0,6        → RX 模式
77 01 80 01   // 0x04 SB r1,0x8001        pin0=RX（N17，UART 收）
07 01 00 05   // 0x08 ADDI r1,r0,5        → TX 模式
77 01 80 03   // 0x0C SB r1,0x8003        pin1=TX（P18，UART 发）
07 01 00 01   // 0x10 ADDI r1,r0,1        → OUT 模式
77 01 80 0D   // 0x14 SB r1,0x800D        pin6=OUT（P15，LED，低电平点亮）
07 01 00 03   // 0x18 ADDI r1,r0,3        → IRQ 模式
77 01 80 0F   // 0x1C SB r1,0x800F        pin7=IRQ（T12，KEY2，低电平触发）
07 02 00 01   // 0x20 ADDI r2,r0,1        r2=1：回环开（默认）
07 07 00 40   // 0x24 ADDI r7,r0,0x40     r7=LED 熄灭常量（写 bit6=1 → pin6 高）
07 01 00 FF   // 0x28 ADDI r1,r0,0xFF
77 01 60 01   // 0x2C SB r1,0x6001        timer cnt_set_h=0xFF
77 01 60 00   // 0x30 SB r1,0x6000        timer cnt_set_l=0xFF（周期 0xFFFF≈65536 拍≈1.31ms@50M）
07 01 00 01   // 0x34 ADDI r1,r0,1
77 01 60 02   // 0x38 SB r1,0x6002        irq_mode=1（timer 中断使能）
@003C
5F 0E 00 00   // 0x3C RBEQ r0,r0 前跳 0x4E      跳过 send_char（bytmov=0x4E-(0x3C+4)=0x0E）
@0040
07 04 00 99   // 0x40 send_char: ADDI r4,r0,0x99    LED 亮 153 tick≈0.2s
63 04 FF 00   // 0x44 LBNE r255,r0 回跳自身        等 tx busy 归零
77 01 40 00   // 0x48 SB r1,0x4000                 发字符（r1）
4D 00         // 0x4C JALR                          返回
@004E
07 01 00 63  21 14   // 0x4E ADDI r1,r0,'c'; 0x52 LJAL 0x40
07 01 00 70  21 1A   // 0x54 ADDI r1,r0,'p'; 0x58 LJAL 0x40
07 01 00 75  21 20   // 0x5A ADDI r1,r0,'u'; 0x5E LJAL 0x40
07 01 00 20  21 26   // 0x60 ADDI r1,r0,' '; 0x64 LJAL 0x40
07 01 00 72  21 2C   // 0x66 ADDI r1,r0,'r'; 0x6A LJAL 0x40
07 01 00 65  21 32   // 0x6C ADDI r1,r0,'e'; 0x70 LJAL 0x40
07 01 00 61  21 38   // 0x72 ADDI r1,r0,'a'; 0x76 LJAL 0x40
07 01 00 64  21 3E   // 0x78 ADDI r1,r0,'d'; 0x7C LJAL 0x40
07 01 00 79  21 44   // 0x7E ADDI r1,r0,'y'; 0x82 LJAL 0x40
07 01 00 0D  21 4A   // 0x84 ADDI r1,r0,'\r'; 0x88 LJAL 0x40
07 01 00 0A  21 50   // 0x8A ADDI r1,r0,'\n'; 0x8E LJAL 0x40
@0090
50            // 0x90 NOP（中断授权点）
50            // 0x91 NOP
5B 06 00 00   // 0x92 LBEQ r0,r0 回跳 0x90（bytmov=(0x96-0x90)=6）等中断
@0096
00 00 00 00 00 00 00 00 00 00   // 0x96-0x9F HALT 填充（主程序区尾，防误入跑 X）
@00A0
33 02 02 01   // 0xA0 GPIO2 ISR(KEY2 按下): XORI r2,r2,1    翻转回环开关
07 05 00 02   // 0xA4 ADDI r5,r0,2        → IN 模式
77 05 80 0F   // 0xA8 SB r5,0x800F        pin7=IN（停 IRQ，防电平持续重触发）
73 05 80 00   // 0xAC LBU r5,0x8000       读引脚（IN：bit7=KEY2）
5B 08 05 00   // 0xB0 LBEQ r5,r0,0xAC     r5==0(仍按住)→回 0xAC 轮询等松手（去抖）
07 05 00 03   // 0xB4 ADDI r5,r0,3        → IRQ 模式
77 05 80 0F   // 0xB8 SB r5,0x800F        pin7=IRQ（恢复；松手高电平不触发）← 占用 GPIO1 向量槽(0xB8)，本程序不用 GPIO1
54            // 0xBC IRET
@00BD
00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00   // 0xBD-0xCF HALT 填充
@00D0
77 00 60 03   // 0xD0 Timer ISR: SB r0,0x6003     ack timer（清 timer_irq）
5F 09 04 00   // 0xD4 RBEQ r4,r0,0xE1     r4==0→LED 灭分支（bytmov=0xE1-0xD8=9）
0F 04 04 01   // 0xD8 SUBI r4,r4,1        r4--（LED 计数递减）
77 00 80 00   // 0xDC SB r0,0x8000        LED 亮（写 bit6=0 → pin6 低）
54            // 0xE0 IRET
77 07 80 00   // 0xE1 SB r7,0x8000        LED 灭（写 bit6=1 → pin6 高）
54            // 0xE5 IRET
@00E6
00 00         // 0xE6-0xE7 HALT 填充
@00E8
73 03 40 00   // 0xE8 UART ISR: LBU r3,0x4000   弹 FIFO（读同时 rx_read 出队）
33 03 03 20   // 0xEC XORI r3,r3,0x20    翻转大小写
5F 06 02 00   // 0xF0 RBEQ r2,r0,0xFA    回环关(r2==0)→跳过回发
07 01 03 00   // 0xF4 ADDI r1,r3,0       r1=收到的字符
21 BA         // 0xF8 LJAL 0x40           send_char 回发（bytmov=(0xFA-0x40)=0xBA）
54            // 0xFA IRET
@00FB
00 00 00 00 00   // 0xFB-0xFF HALT 填充
