5C000240   // RBEQ  r4, r0, led_off      # r4==0 → LED 灭分支（向前）
0C040401   // SUBI  r4, r4, 1            # r4--（LED 计数递减）
74004000   // SB    r0, GPIO             # LED 亮（写 bit6=0 → pin6 低）
54000000   // IRET
74074000   // SB    r7, GPIO             # LED 灭（写 bit6=1 → pin6 高）
54000000   // IRET
