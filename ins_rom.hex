@0000
07 01 00 06   // ADDI  r1, r0, MODE_RX     # 0x00 pin0=RX（N17，UART 收）
77 01 80 01   // SB    r1, GPIO_PIN0       # 0x04
07 01 00 05   // ADDI  r1, r0, MODE_TX     # 0x08 pin1=TX（P18，UART 发）
77 01 80 03   // SB    r1, GPIO_PIN1       # 0x0C
07 01 00 01   // ADDI  r1, r0, MODE_OUT    # 0x10 pin6=OUT（P15，LED，低电平点亮）
77 01 80 0D   // SB    r1, GPIO_PIN6       # 0x14
07 01 00 03   // ADDI  r1, r0, MODE_IRQ    # 0x18 pin7=IRQ（T12，KEY2，低电平触发）
77 01 80 0F   // SB    r1, GPIO_PIN7       # 0x1C
07 02 00 01   // ADDI  r2, r0, 1           # 0x20 r2=1：回环开（默认）
07 07 00 40   // ADDI  r7, r0, 0x40        # 0x24 r7=LED 熄灭常量（写 bit6=1 → pin6 高）
07 01 00 FF   // ADDI  r1, r0, 0xFF        # 0x28
77 01 60 01   // SB    r1, TIMER_CNT_H     # 0x2C timer cnt_set_h=0xFF
77 01 60 00   // SB    r1, TIMER_CNT_L     # 0x30 timer cnt_set_l=0xFF（周期 0xFFFF≈65536 拍≈1.31ms@50M）
07 01 00 01   // ADDI  r1, r0, 1           # 0x34
77 01 60 02   // SB    r1, TIMER_IRQ       # 0x38 irq_mode=1（timer 中断使能）
5F 0E 00 00   // RBEQ  r0, r0, 0x4E        # 0x3C 跳过 send_char（bytmov=0x4E-(0x3C+4)=0x0E）
07 04 00 99   // ADDI  r4, r0, 0x99        # 0x40 send_char: LED 亮 153 tick≈0.2s
63 04 FF 00   // LBNE  r255, r0, 0x44      # 0x44 回跳自身，等 tx busy 归零
77 01 40 00   // SB    r1, UART            # 0x48 发字符（r1）
4D 00   // JALR                      # 0x4C 返回
07 01 00 63   // ADDI  r1, r0, 'c'         # 0x4E
21 14   // LJAL  0x40                # 0x52 send_char('c')
07 01 00 70   // ADDI  r1, r0, 'p'         # 0x54
21 1A   // LJAL  0x40                # 0x58
07 01 00 75   // ADDI  r1, r0, 'u'         # 0x5A
21 20   // LJAL  0x40                # 0x5E
07 01 00 20   // ADDI  r1, r0, ' '         # 0x60
21 26   // LJAL  0x40                # 0x64
07 01 00 72   // ADDI  r1, r0, 'r'         # 0x66
21 2C   // LJAL  0x40                # 0x6A
07 01 00 65   // ADDI  r1, r0, 'e'         # 0x6C
21 32   // LJAL  0x40                # 0x70
07 01 00 61   // ADDI  r1, r0, 'a'         # 0x72
21 38   // LJAL  0x40                # 0x76
07 01 00 64   // ADDI  r1, r0, 'd'         # 0x78
21 3E   // LJAL  0x40                # 0x7C
07 01 00 79   // ADDI  r1, r0, 'y'         # 0x7E
21 44   // LJAL  0x40                # 0x82
07 01 00 0D   // ADDI  r1, r0, '\r'        # 0x84
21 4A   // LJAL  0x40                # 0x88
07 01 00 0A   // ADDI  r1, r0, '\n'        # 0x8A
21 50   // LJAL  0x40                # 0x8E
50   // NOP                       # 0x90 中断授权点
50   // NOP                       # 0x91
5B 06 00 00   // LBEQ  r0, r0, 0x90        # 0x92 回跳 0x90 等中断（bytmov=(0x96-0x90)=6）
00 00 00 00 00 00 00 00
00 00
33 02 02 01   // XORI  r2, r2, 1           # 0xA0 GPIO2 ISR(KEY2 按下): 翻转回环开关
07 05 00 02   // ADDI  r5, r0, MODE_IN     # 0xA4 → IN 模式
77 05 80 0F   // SB    r5, GPIO_PIN7       # 0xA8 pin7=IN（停 IRQ，防电平持续重触发）
73 05 80 00   // LBU   r5, GPIO            # 0xAC 读引脚（IN：bit7=KEY2）
5B 08 05 00   // LBEQ  r5, r0, 0xAC        # 0xB0 r5==0(仍按住)→回 0xAC 轮询等松手（去抖）
07 05 00 03   // ADDI  r5, r0, MODE_IRQ    # 0xB4 → IRQ 模式
77 05 80 0F   // SB    r5, GPIO_PIN7       # 0xB8 pin7=IRQ（恢复；松手高电平不触发）
54   // IRET                      # 0xBC
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00
77 00 60 03   // SB    r0, TIMER_ACK       # 0xD0 Timer ISR: ack timer（清 timer_irq）
5F 09 04 00   // RBEQ  r4, r0, 0xE1        # 0xD4 r4==0→LED 灭分支（bytmov=0xE1-0xD8=9）
0F 04 04 01   // SUBI  r4, r4, 1           # 0xD8 r4--（LED 计数递减）
77 00 80 00   // SB    r0, GPIO            # 0xDC LED 亮（写 bit6=0 → pin6 低）
54   // IRET                      # 0xE0
77 07 80 00   // SB    r7, GPIO            # 0xE1 LED 灭（写 bit6=1 → pin6 高）
54   // IRET                      # 0xE5
00 00
73 03 40 00   // LBU   r3, UART            # 0xE8 UART ISR: 弹 FIFO（读同时 rx_read 出队）
33 03 03 20   // XORI  r3, r3, 0x20        # 0xEC 翻转大小写
5F 06 02 00   // RBEQ  r2, r0, 0xFA        # 0xF0 回环关(r2==0)→跳过回发
07 01 03 00   // ADDI  r1, r3, 0           # 0xF4 r1=收到的字符
21 BA   // LJAL  0x40                # 0xF8 send_char 回发（bytmov=(0xFA-0x40)=0xBA）
54   // IRET                      # 0xFA
00 00 00 00 00
