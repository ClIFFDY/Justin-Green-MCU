@0000
06 01 00 06   // ADDI  r1, r0, MODE_RX     # 0x00 pin0=RX（N17，UART 收）
76 01 40 01   // SB    r1, GPIO_PIN0       # 0x04
06 01 00 05   // ADDI  r1, r0, MODE_TX     # 0x08 pin1=TX（P18，UART 发）
76 01 40 03   // SB    r1, GPIO_PIN1       # 0x0C
06 01 00 01   // ADDI  r1, r0, MODE_OUT    # 0x10 pin6=OUT（P15，LED，低电平点亮）
76 01 40 0D   // SB    r1, GPIO_PIN6       # 0x14
06 01 00 03   // ADDI  r1, r0, MODE_IRQ    # 0x18 pin7=IRQ（T12，KEY2，低电平触发）
76 01 40 0F   // SB    r1, GPIO_PIN7       # 0x1C
06 02 00 01   // ADDI  r2, r0, 1           # 0x20 r2=1：回环开（默认）
06 07 00 40   // ADDI  r7, r0, 0x40        # 0x24 r7=LED 熄灭常量（写 bit6=1 → pin6 高）
06 01 00 FF   // ADDI  r1, r0, 0xFF        # 0x28
76 01 30 01   // SB    r1, TIMER_CNT1      # 0x2C timer cnt_set[1]=0xFF
76 01 30 00   // SB    r1, TIMER_CNT0      # 0x30 timer cnt_set[0]=0xFF（周期 0x0000FFFF≈65536 拍≈1.31ms@50M）
06 01 00 01   // ADDI  r1, r0, 1           # 0x34
76 01 30 04   // SB    r1, TIMER_MODE      # 0x38 irq_mode=1（timer 中断使能）
27 0C 00 00 F0   // RJAL  0x110               # 0x3C banner 子程序（只执行一次）
50 00   // NOP                       # 0x41 中断授权点
50 00   // NOP                       # 0x43
5B 00 00 00 90   // LBEQ  r0, r0, 0x41        # 0x45 回跳 0x41 等中断（bytmov=0x4A-0x41=9）
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00
32 02 02 01   // XORI  r2, r2, 1           # 0x88 GPIO2 ISR(KEY2 按下): 翻转回环开关
06 05 00 02   // ADDI  r5, r0, MODE_IN     # 0x8C → IN 模式
76 05 40 0F   // SB    r5, GPIO_PIN7       # 0x90 pin7=IN（停 IRQ，防电平持续重触发）
72 05 40 00   // LBU   r5, GPIO            # 0x94 读引脚（IN：bit7=KEY2）
5B 00 05 00 90   // LBEQ  r5, r0, 0x94        # 0x98 r5==0(仍按住)→回 0x94 轮询等松手（去抖）
06 05 00 03   // ADDI  r5, r0, MODE_IRQ    # 0x9D → IRQ 模式
76 05 40 0F   // SB    r5, GPIO_PIN7       # 0xA1 pin7=IRQ（恢复；松手高电平不触发）
54 00   // IRET                      # 0xA5
00
54 00   // IRET                      # 0xA8 GPIO1 ISR 占位（本程序未用，防误触发挂死）
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00
76 00 30 05   // SB    r0, TIMER_ACK       # 0xC8 Timer ISR: ack timer（清 timer_irq）
5F 00 04 00 A0   // RBEQ  r4, r0, 0xDB        # 0xCC r4==0→跳 0xDB 直接返回（LED 保持当前）
0E 04 04 01   // SUBI  r4, r4, 1           # 0xD1 r4--（LED 计数递减）
76 00 40 00   // SB    r0, GPIO            # 0xD5 LED 亮（写 bit6=0 → pin6 低）
54 00   // IRET                      # 0xD9
54 00   // IRET                      # 0xDB r4==0 路径返回
00 00 00
72 03 20 00   // LBU   r3, UART            # 0xE0 UART ISR: 弹 FIFO（读同时 rx_read 出队）
32 03 03 20   // XORI  r3, r3, 0x20        # 0xE4 翻转大小写
5F 00 02 00 90   // RBEQ  r2, r0, 0xF6        # 0xE8 回环关(r2==0)→跳过回发（bytmov=0xF6-0xED=9）
06 01 03 00   // ADDI  r1, r3, 0           # 0xED r1=收到的字符
27 00 00 00 A0   // RJAL  0x100               # 0xF1 send_char 回发（bytmov=0x100-0xF6=10）
54 00   // IRET                      # 0xF6
00 00 00 00 00 00 00 00
06 04 00 99   // ADDI  r4, r0, 0x99        # 0x100 send_char: LED 亮 153 tick≈0.2s
63 00 FF 00 50   // LBNE  r255, r0, 0x104     # 0x104 回跳自身，等 tx busy 归零
76 01 20 00   // SB    r1, UART            # 0x109 发字符（r1）
4C 00   // JALR                      # 0x10D 返回
00
06 01 00 63   // ADDI  r1, r0, 'c'         # 0x110 banner "cpu ready\r\n"
23 01 00 00 90   // LJAL  0x100               # 0x114 send_char('c')（banner 高于 send_char，向后压栈调用）
06 01 00 70   // ADDI  r1, r0, 'p'         # 0x119
23 02 00 00 20   // LJAL  0x100               # 0x11D
06 01 00 75   // ADDI  r1, r0, 'u'         # 0x122
23 02 00 00 B0   // LJAL  0x100               # 0x126
06 01 00 20   // ADDI  r1, r0, ' '         # 0x12B
23 03 00 00 40   // LJAL  0x100               # 0x12F
06 01 00 72   // ADDI  r1, r0, 'r'         # 0x134
23 03 00 00 D0   // LJAL  0x100               # 0x138
06 01 00 65   // ADDI  r1, r0, 'e'         # 0x13D
23 04 00 00 60   // LJAL  0x100               # 0x141
06 01 00 61   // ADDI  r1, r0, 'a'         # 0x146
23 04 00 00 F0   // LJAL  0x100               # 0x14A
06 01 00 64   // ADDI  r1, r0, 'd'         # 0x14F
23 05 00 00 80   // LJAL  0x100               # 0x153
06 01 00 79   // ADDI  r1, r0, 'y'         # 0x158
23 06 00 00 10   // LJAL  0x100               # 0x15C
06 01 00 0D   // ADDI  r1, r0, '\r'        # 0x161
23 06 00 00 A0   // LJAL  0x100               # 0x165
06 01 00 0A   // ADDI  r1, r0, '\n'        # 0x16A
23 07 00 00 30   // LJAL  0x100               # 0x16E
4C 00   // JALR                      # 0x173 返回主循环
