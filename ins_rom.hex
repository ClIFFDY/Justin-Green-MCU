@0000
078107C2   // ADDI  r2, r0, 1            # 词 0 上：r2=1 回环开（默认） | ADDI  r3, r0, 2            # 词 0 下：r3=2（仅作压缩测试，随后会被 UART ISR 覆盖）
04070040   // ADDI  r7, r0, 0x40         # r7=LED 熄灭常量（写 bit6=1 → pin6 高）
04010006   // ADDI  r1, r0, MODE_RX      # pin0=RX（N17，UART 收）
74014001   // SB    r1, GPIO_PIN0
04010005   // ADDI  r1, r0, MODE_TX      # pin1=TX（P18，UART 发）
74014003   // SB    r1, GPIO_PIN1
04010001   // ADDI  r1, r0, MODE_OUT     # pin6=OUT（P15，LED，低电平点亮）
7401400D   // SB    r1, GPIO_PIN6
74074000   // SB    r7, GPIO             # 初始 LED 灭
04010003   // ADDI  r1, r0, MODE_IRQ     # pin7=IRQ（V13，低电平触发）
7401400F   // SB    r1, GPIO_PIN7
040100FF   // ADDI  r1, r0, 0xFF         # timer cnt_set[1]=0xFF
74013001   // SB    r1, TIMER_CNT1
74013000   // SB    r1, TIMER_CNT0       # timer cnt_set[0]=0xFF（周期≈65536 拍≈1.31ms@50M）
04010001   // ADDI  r1, r0, 1
74013004   // SB    r1, TIMER_MODE       # irq_mode=1（timer 中断使能）
04010063   // ADDI  r1, r0, 'c'
24001600   // RJAL  send_char
04010070   // ADDI  r1, r0, 'p'
24001400   // RJAL  send_char
04010075   // ADDI  r1, r0, 'u'
24001200   // RJAL  send_char
04010020   // ADDI  r1, r0, ' '
24001000   // RJAL  send_char
04010072   // ADDI  r1, r0, 'r'
24000E00   // RJAL  send_char
04010065   // ADDI  r1, r0, 'e'
24000C00   // RJAL  send_char
04010061   // ADDI  r1, r0, 'a'
24000A00   // RJAL  send_char
04010064   // ADDI  r1, r0, 'd'
24000800   // RJAL  send_char
04010079   // ADDI  r1, r0, 'y'
24000600   // RJAL  send_char
0401000D   // ADDI  r1, r0, '\r'
24000400   // RJAL  send_char
0401000A   // ADDI  r1, r0, '\n'
24000200   // RJAL  send_char
51005100   // NOP                        # 词 N：授权点（bytmov=0，两拍） | NOP
58000300   // LBEQ  r0, r0, main_loop    # 词 N+1：回跳（bytmov≠0，不授权）
58000400   // LBEQ  r0, r0, main_loop    # 词 N+2：IRET 落点，回跳
0406FF00   // ADDI  r6, r255, 0          # 复制 tx_busy 到低寄存器（分支寄存器限 4 位）
60000360   // LBNE  r6, r0, send_char    # busy 则回跳自身（向后 3 词）
74012000   // SB    r1, UART             # 发字符
4C000000   // JALR                       # 返回
