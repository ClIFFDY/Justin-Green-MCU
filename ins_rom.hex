70032000   // LBU   r3, UART             # 弹 FIFO（读同时 rx_read 出队）
04040099   // ADDI  r4, r0, 0x99         # 收到数据→LED 亮 153 tick≈0.2s
30030320   // XORI  r3, r3, 0x20         # 翻转大小写
5C000120   // RBEQ  r2, r0, uart_done    # 回环关(r2==0)→跳过回发（向前）
04010300   // ADDI  r1, r3, 0            # r1=收到的字符
2000BE00   // LJAL  send_char            # send_char 回发（向后调用）
54000000   // IRET
