04050002   // ADDI  r5, r0, MODE_IN      # → IN 模式
7405400F   // SB    r5, GPIO_PIN7        # pin7=IN（停 IRQ，防电平持续重触发）
70054000   // LBU   r5, GPIO             # 读引脚（IN：bit7=V13）
58000350   // LBEQ  r5, r0, gpio2_poll   # r5==0(仍按住)→回读轮询等松手（去抖）
04050003   // ADDI  r5, r0, MODE_IRQ     # → IRQ 模式
7405400F   // SB    r5, GPIO_PIN7        # pin7=IRQ（恢复；松手高电平不触发）
54000000   // IRET
