@0000
07 01 00 06   // ADDI  r1, r0, MODE_RX     # 0x00 pin0=RX（N17，UART 收）
77 01 40 01   // SB    r1, GPIO_PIN0       # 0x04
07 01 00 05   // ADDI  r1, r0, MODE_TX     # 0x08 pin1=TX（P18，UART 发）
77 01 40 03   // SB    r1, GPIO_PIN1       # 0x0C
07 01 00 01   // ADDI  r1, r0, MODE_OUT    # 0x10 pin6=OUT（P15，LED，低电平点亮）
77 01 40 0D   // SB    r1, GPIO_PIN6       # 0x14
07 01 00 03   // ADDI  r1, r0, MODE_IRQ    # 0x18 pin7=IRQ（T12，KEY2，低电平触发）
77 01 40 0F   // SB    r1, GPIO_PIN7       # 0x1C
07 02 00 01   // ADDI  r2, r0, 1           # 0x20 r2=1：回环开（默认）
07 07 00 40   // ADDI  r7, r0, 0x40        # 0x24 r7=LED 熄灭常量（写 bit6=1 → pin6 高）
07 01 00 FF   // ADDI  r1, r0, 0xFF        # 0x28
77 01 30 01   // SB    r1, TIMER_CNT1      # 0x2C timer cnt_set[1]=0xFF
77 01 30 00   // SB    r1, TIMER_CNT0      # 0x30 timer cnt_set[0]=0xFF（周期 0x0000FFFF≈65536 拍≈1.31ms@50M）
07 01 00 01   // ADDI  r1, r0, 1           # 0x34
77 01 30 04   // SB    r1, TIMER_MODE      # 0x38 irq_mode=1（timer 中断使能）
07 01 00 63   // ADDI  r1, r0, 'c'         # 0x3C banner "cpu ready\r\n"
25 BE   // RJAL  0x100               # 0x40 send_char('c')
07 01 00 70   // ADDI  r1, r0, 'p'         # 0x42
25 B8   // RJAL  0x100               # 0x46
07 01 00 75   // ADDI  r1, r0, 'u'         # 0x48
25 B2   // RJAL  0x100               # 0x4C
07 01 00 20   // ADDI  r1, r0, ' '         # 0x4E
25 AC   // RJAL  0x100               # 0x52
07 01 00 72   // ADDI  r1, r0, 'r'         # 0x54
25 A6   // RJAL  0x100               # 0x58
07 01 00 65   // ADDI  r1, r0, 'e'         # 0x5A
25 A0   // RJAL  0x100               # 0x5E
07 01 00 61   // ADDI  r1, r0, 'a'         # 0x60
25 9A   // RJAL  0x100               # 0x64
07 01 00 64   // ADDI  r1, r0, 'd'         # 0x66
25 94   // RJAL  0x100               # 0x6A
07 01 00 79   // ADDI  r1, r0, 'y'         # 0x6C
25 8E   // RJAL  0x100               # 0x70
07 01 00 0D   // ADDI  r1, r0, '\r'        # 0x72
25 88   // RJAL  0x100               # 0x76
07 01 00 0A   // ADDI  r1, r0, '\n'        # 0x78
25 82   // RJAL  0x100               # 0x7C
50   // NOP                       # 0x7E 中断授权点
50   // NOP                       # 0x7F
5B 06 00 00   // LBEQ  r0, r0, 0x7E        # 0x80 回跳 0x7E 等中断（bytmov=(0x84-0x7E)=6）
00 00 00 00
33 02 02 01   // XORI  r2, r2, 1           # 0x88 GPIO2 ISR(KEY2 按下): 翻转回环开关
07 05 00 02   // ADDI  r5, r0, MODE_IN     # 0x8C → IN 模式
77 05 40 0F   // SB    r5, GPIO_PIN7       # 0x90 pin7=IN（停 IRQ，防电平持续重触发）
73 05 40 00   // LBU   r5, GPIO            # 0x94 读引脚（IN：bit7=KEY2）
5B 08 05 00   // LBEQ  r5, r0, 0x94        # 0x98 r5==0(仍按住)→回 0x94 轮询等松手（去抖）
07 05 00 03   // ADDI  r5, r0, MODE_IRQ    # 0x9C → IRQ 模式
77 05 40 0F   // SB    r5, GPIO_PIN7       # 0xA0 pin7=IRQ（恢复；松手高电平不触发）
54   // IRET                      # 0xA4
00 00 00
54   // IRET                      # 0xA8 GPIO1 ISR 占位（本程序未用，防误触发挂死）
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00 00 00 00
77 00 30 05   // SB    r0, TIMER_ACK       # 0xC8 Timer ISR: ack timer（清 timer_irq）
5F 09 04 00   // RBEQ  r4, r0, 0xD9        # 0xCC r4==0→LED 灭分支（bytmov=0xD9-0xD0=9）
0F 04 04 01   // SUBI  r4, r4, 1           # 0xD0 r4--（LED 计数递减）
77 00 40 00   // SB    r0, GPIO            # 0xD4 LED 亮（写 bit6=0 → pin6 低）
54   // IRET                      # 0xD8
77 07 40 00   // SB    r7, GPIO            # 0xD9 LED 灭（写 bit6=1 → pin6 高）
54   // IRET                      # 0xDD
00 00
73 03 20 00   // LBU   r3, UART            # 0xE0 UART ISR: 弹 FIFO（读同时 rx_read 出队）
33 03 03 20   // XORI  r3, r3, 0x20        # 0xE4 翻转大小写
5F 06 02 00   // RBEQ  r2, r0, 0xF2        # 0xE8 回环关(r2==0)→跳过回发
07 01 03 00   // ADDI  r1, r3, 0           # 0xEC r1=收到的字符
25 0E   // RJAL  0x100               # 0xF0 send_char 回发（bytmov=0x100-0xF2=14）
54   // IRET                      # 0xF2
00 00 00 00 00 00 00 00
00 00 00 00 00
07 04 00 99   // ADDI  r4, r0, 0x99        # 0x100 send_char: LED 亮 153 tick≈0.2s
63 04 FF 00   // LBNE  r255, r0, 0x104     # 0x104 回跳自身，等 tx busy 归零
77 01 20 00   // SB    r1, UART            # 0x108 发字符（r1）
4D 00   // JALR                      # 0x10C 返回
00 00 00 00 00 00 00 00
